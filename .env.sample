# Sidecar configuration. Copy this file to .env and replace placeholders.
# Use debug temporarily when diagnosing an integration problem.
LOG_LEVEL=info
SIDECARR_SCRIBERR_URL=https://scriberr.example.com
# Browser-facing URL used for links. Useful when SIDECARR_SCRIBERR_URL is an
# internal Docker address such as http://scriberr:8080.
SIDECARR_SCRIBERR_PUBLIC_URL=https://scriberr.example.com
SIDECARR_SCRIBERR_API_KEY=replace-me
SIDECARR_API_TIMEOUT_SECONDS=15
SIDECARR_API_MAX_ATTEMPTS=3
SIDECARR_API_RETRY_BASE_MILLISECONDS=500

# Optional MQTT publishing. Leave this entire section commented to disable it.
# SIDECARR_MQTT_URL=mqtt://mosquitto:1883
# SIDECARR_MQTT_USERNAME=
# SIDECARR_MQTT_PASSWORD=
# SIDECARR_MQTT_TOPIC_PREFIX=home/audio/scriberr
# SIDECARR_MQTT_QOS=1
# SIDECARR_MQTT_RETAIN=false

# Optional job_ready webhook. Compatible with n8n, Pipedream, Apprise, and
# ordinary HTTP receivers. The token is sent as a Bearer token when present.
# SIDECARR_NOTIFICATION_WEBHOOK_URL=https://automation.example.com/webhook/scriberr-ready
# SIDECARR_NOTIFICATION_WEBHOOK_TOKEN=replace-me

# Optional direct job_ready email. URL-encode credentials containing special
# characters. Use smtp://...:587 for STARTTLS or smtps://...:465 for TLS.
# SIDECARR_SMTP_URL=smtps://username:password@smtp.example.com:465
# SIDECARR_EMAIL_FROM=Scriberr <scriberr@example.com>
# SIDECARR_EMAIL_TO=you@example.com
# SIDECARR_EMAIL_SUBJECT_TEMPLATE=Scriberr job ready: {title}

# If auto-summarize isn't enabled in Scriberr, the sidecar can hack it
SIDECARR_AUTOGENERATE_SUMMARY=true
SIDECARR_SUMMARY_TEMPLATE=Default # name of template from Scriberr
SIDECARR_SUMMARY_POLL_INTERVAL_SECONDS=30
SIDECARR_SUMMARY_TIMEOUT_SECONDS=3600

# Optional Notion destination. Create an internal Notion integration, share an
# ordinary parent page with it, then uncomment all three required settings.
# SIDECARR_NOTEBOOK_PROVIDER=notion
# SIDECARR_NOTION_TOKEN=secret_replace-me
# SIDECARR_NOTION_PARENT_PAGE_URL=https://www.notion.so/your-parent-page-id
# Existing jobs are ignored by default. Set true for an intentional backfill.
# SIDECARR_NOTION_BACKFILL=false

# Recommended. Sidecarr registers and secures its own webhook.
# If Scriberr does not support webhook management, Sidecarr automatically
# falls back to the filesystem settings below.
SIDECARR_DISCOVERY_MODE=webhook

# Used when SIDECARR_DISCOVERY_MODE=filesystem or webhook registration falls back.
SIDECARR_WATCH_FOLDER=/watch/transcripts
SIDECARR_SCAN_INTERVAL_SECONDS=30
